{
    "name": "jolicode/elastically",
    "description": "Opinionated Elastica based framework to bootstrap PHP and Elasticsearch implementations.",
    "keywords": [
        "Elasticsearch",
        "Elastica",
        "Symfony",
        "Search"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Damien Alexandre",
            "homepage": "https://jolicode.com/"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^5.2 || ^6.0",
        "ruflin/elastica": "^8.0 || ^9.0",
        "symfony/property-access": "^6.4 || ^7.4 || ^8.0",
        "symfony/property-info": "^6.4 || ^7.4 || ^8.0",
        "symfony/psr-http-message-bridge": "^6.4 || ^7.4 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "jane-php/json-schema": "^7.4",
        "jane-php/json-schema-runtime": "^7.4",
        "phpstan/phpstan": "^2.1.31",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.4 || ^8.0",
        "symfony/phpunit-bridge": "^6.4.1 || ^7.4 || ^8.0"
    },
    "suggest": {
        "symfony/json-streamer": "Speeds up the serialization process"
    },
    "conflict": {
        "nikic/php-parser": "<4.7"
    },
    "autoload": {
        "psr-4": {
            "JoliCode\\Elastically\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JoliCode\\Elastically\\Tests\\": "./tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true
        }
    }
}
