{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block head %}
    {{ parent() }}

    <style>
        .sf-profiler-elastically-requests .http-method {
            border: 1px solid var(--header-status-request-method-color);
            border-radius: 5px;
            color: var(--header-status-request-method-color);
            display: inline-block;
            font-weight: 500;
            line-height: 1;
            margin-right: 6px;
            padding: 2px 4px;
            text-align: center;
            white-space: nowrap;
        }
        .sf-profiler-elastically-requests .status-code {
            background: var(--gray-600);
            border-radius: 4px;
            color: var(--white);
            display: inline-block;
            font-size: 12px;
            font-weight: bold;
            padding: 1px 3px;
        }
        .sf-profiler-elastically-requests .status-code.status-success { background: var(--header-success-status-code-background); color: var(--header-success-status-code-color); }
        .sf-profiler-elastically-requests .status-code.status-warning { background: var(--header-warning-status-code-background); color: var(--header-warning-status-code-color); }
        .sf-profiler-elastically-requests .status-code.status-error { background: var(--header-error-status-code-background); color: var(--header-error-status-code-color); }
        .sf-profiler-elastically-requests td { vertical-align: top; }
        .sf-profiler-elastically-requests .col-narrow { width: 1%; white-space: nowrap; }
        .sf-profiler-elastically-requests .request-path,
        .sf-profiler-elastically-requests .request-error { word-break: break-all; }
        .sf-profiler-elastically-requests .request-error { margin-top: 5px; }
        .sf-profiler-elastically-requests .request-actions { margin-top: 5px; }
        .sf-profiler-elastically-requests .request-actions .btn { margin-right: 5px; }
        .sf-profiler-elastically-requests .request-details { margin-top: 10px; }
        .sf-profiler-elastically-requests .request-details h4 { margin: 0 0 5px; }
        .sf-profiler-elastically-requests .badge-duplicated { background: var(--badge-warning-background); color: var(--badge-warning-color); box-shadow: var(--badge-warning-shadow); }
        .sf-profiler-elastically-duplicates { background: var(--badge-warning-background); color: var(--badge-warning-color); border-radius: 6px; margin: 0 0 1em; padding: 10px 15px; }
    </style>
{% endblock %}

{% block toolbar %}
    {% if collector.requestCount %}
        {% set status_color = collector.errorCount ? 'red' : (collector.duplicateCount ? 'yellow' : '') %}

        {% set icon %}
            {{ source('@WebProfiler/Icon/search.svg') }}
            <span class="sf-toolbar-value">{{ collector.requestCount }}</span>
            <span class="sf-toolbar-info-piece-additional-detail">
                <span class="sf-toolbar-label">in</span>
                <span class="sf-toolbar-value">{{ '%0.2f'|format(collector.duration) }}</span>
                <span class="sf-toolbar-label">ms</span>
            </span>
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Elasticsearch requests</b>
                <span class="sf-toolbar-status">{{ collector.requestCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Request time</b>
                <span>{{ '%0.2f'|format(collector.duration) }} ms</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Errors</b>
                <span class="sf-toolbar-status {{ collector.errorCount ? 'sf-toolbar-status-red' }}">{{ collector.errorCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Duplicated requests</b>
                <span class="sf-toolbar-status {{ collector.duplicateCount ? 'sf-toolbar-status-yellow' }}">{{ collector.duplicateCount }}</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: status_color}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.requestCount ? (collector.errorCount ? 'label-status-error' : (collector.duplicateCount ? 'label-status-warning')) : 'disabled' }}">
        <span class="icon">{{ source('@WebProfiler/Icon/search.svg') }}</span>
        <strong>Elastically</strong>
        {% if collector.requestCount %}
            <span class="count">{{ collector.requestCount }}</span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>Elastically</h2>

    {% if collector.connections is empty %}
        <div class="empty empty-panel">
            <p>No Elastically connection is configured.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.requestCount }}</span>
                <span class="label">Requests</span>
            </div>
            <div class="metric">
                <span class="value">{{ '%0.2f'|format(collector.duration) }} <span class="unit">ms</span></span>
                <span class="label">Request time</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.errorCount }}</span>
                <span class="label">Errors</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.duplicateCount }}</span>
                <span class="label">Duplicated requests</span>
            </div>
        </div>

        {% if collector.duplicateCount %}
            <p class="sf-profiler-elastically-duplicates">
                {{ collector.duplicateCount }} request(s) were sent more than once with the same method, URL and body. They could probably be avoided.
            </p>
        {% endif %}

        <h2>Connections</h2>

        <div class="sf-tabs">
            {% for name, connection in collector.connections %}
                <div class="tab {{ connection.requests is empty ? 'disabled' }}">
                    <h3 class="tab-title">{{ name }} <span class="badge">{{ connection.requests|length }}</span></h3>

                    <div class="tab-content">
                        <p class="text-muted">Hosts: {{ connection.hosts|join(', ') }}</p>

                        {% if connection.requests is empty %}
                            <div class="empty">
                                <p>No request was sent with the "{{ name }}" connection.</p>
                            </div>
                        {% else %}
                            <table class="sf-profiler-elastically-requests">
                                <thead>
                                    <tr>
                                        <th class="col-narrow">#</th>
                                        <th class="col-narrow">Time</th>
                                        <th class="col-narrow">Status</th>
                                        <th>Request</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for request in connection.requests %}
                                        {% set request_id = 'elastically-' ~ name ~ '-' ~ loop.index %}
                                        <tr>
                                            <td class="col-narrow font-normal text-muted">{{ loop.index }}</td>
                                            <td class="col-narrow">{{ '%0.2f'|format(request.duration) }}&nbsp;ms</td>
                                            <td class="col-narrow">
                                                {% if request.status_code %}
                                                    <span class="status-code status-{{ request.status_code >= 500 ? 'error' : (request.status_code >= 400 ? 'warning' : 'success') }}">{{ request.status_code }}</span>
                                                {% else %}
                                                    <span class="status-code status-error">n/a</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="http-method">{{ request.method }}</span>
                                                <span class="request-path">{{ request.path }}</span>

                                                {% if request.occurrences > 1 %}
                                                    <span class="badge badge-duplicated" title="This exact request was sent {{ request.occurrences }} times">Duplicated ×{{ request.occurrences }}</span>
                                                {% endif %}

                                                {% if request.error %}
                                                    <div class="request-error text-danger">{{ request.error|length > 300 ? request.error|slice(0, 300) ~ '…' : request.error }}</div>
                                                {% endif %}

                                                <div class="request-actions">
                                                    {% if request.request_body is not null %}
                                                        <button type="button" class="btn btn-link text-small sf-toggle" data-toggle-selector="#{{ request_id }}-request" data-toggle-alt-content="Hide request body">View request body</button>
                                                    {% endif %}
                                                    {% if request.response_body is not null %}
                                                        <button type="button" class="btn btn-link text-small sf-toggle" data-toggle-selector="#{{ request_id }}-response" data-toggle-alt-content="Hide response">View response</button>
                                                    {% endif %}
                                                    <button type="button" class="btn btn-sm hidden" title="Copy the request as a cURL command (credentials are not included)" data-clipboard-text="{{ request.curl_command }}">Copy as cURL</button>
                                                    <button type="button" class="btn btn-sm hidden" title="Copy the request for the Kibana Dev Tools console" data-clipboard-text="{{ request.console_command }}">Copy for Kibana Dev Tools</button>
                                                </div>

                                                {% if request.request_body is not null %}
                                                    <div id="{{ request_id }}-request" class="request-details sf-toggle-content sf-toggle-hidden">
                                                        <h4>Request body</h4>
                                                        {{ profiler_dump(request.request_body, maxDepth: 5) }}
                                                    </div>
                                                {% endif %}
                                                {% if request.response_body is not null %}
                                                    <div id="{{ request_id }}-response" class="request-details sf-toggle-content sf-toggle-hidden">
                                                        <h4>Response</h4>
                                                        {{ profiler_dump(request.response_body, maxDepth: 5) }}
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
